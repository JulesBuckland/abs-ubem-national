graph LR
    subgraph Priors
        P1(beta_th prior)
        P2(beta_inc prior)
        P3(sigma_y prior)
        P4(tau_phi prior)
    end

    subgraph Neighborhood_Level ["Neighborhood Level (m)"]
        IMD[IMD Score Z_inc]
        Phi[Spatial Effect phi_m]
        Theta[Unstructured Effect theta_m]
    end

    subgraph Household_Level ["Household Level (h)"]
        Th[Theoretical Requirement T_h]
        Y[Metered Consumption y_h]
        $T^*$[Estimated $T^*$]
    end

    P1 --> Y
    P2 --> Y
    IMD --> Y
    P3 --> Y
    P4 --> Phi
    Phi --> Y
    Theta --> Y
    Th --> Y
    
    Y -.-> $T^*$
    Phi -.-> $T^*$
    Theta -.-> $T^*$
    IMD -.-> $T^*$

    style Y fill:#f9f,stroke:#333,stroke-width:2px
    style $T^*$ fill:#bfb,stroke:#333,stroke-width:2px
    style Neighborhood_Level fill:#fff,stroke:#333,stroke-dasharray: 5 5
    style Household_Level fill:#fff,stroke:#333,stroke-dasharray: 5 5
