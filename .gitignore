# Data and outputs
data/
# tests/fixtures/* (not tests/fixtures/) so the golden-baseline negation below
# actually works: git cannot re-include anything inside a directory excluded
# by a plain "dir/" pattern, only inside one excluded via "dir/*".
tests/fixtures/*
outputs/
*.parquet
*.nc
*.pkl

# Golden-test baselines are the exception: they must be committed and persist
# across CI runs, or test_golden.py silently creates a fresh baseline every
# run instead of ever comparing against one.
!tests/fixtures/golden/
!tests/fixtures/golden/**

# Python
__pycache__/
*.pyc
.pytest_cache/
.hypothesis/
.venv/
.env
.temp downloads/

# OS
.DS_Store

# Exclude massive folders from Github packaging
archive/
journal_resources/
literature/
logs/
scratch/
papers/
tasks/
meta/

.ignored/
python-installer.exe
scratch_scripts/

# Private research files
manuscript/
github_submission/
docs/
GEMINI.md
TESTING_STRATEGY.md
methodology.txt
